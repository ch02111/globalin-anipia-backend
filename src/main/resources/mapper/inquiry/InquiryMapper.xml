<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.afivestudio.anipia.inquiry.infra.InquiryMapper">

  <resultMap id="InquiryResultMap" type="Inquiry" autoMapping="true">
    <id property="id" column="inquiry_id"/>
    <result property="email" column="writer_email"/>
    <result property="title" column="subject"/>
    <result property="processed" column="is_resolved"/>
    <result property="inquiryType" column="type" javaType="InquiryType"/>
  </resultMap>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO inquiries
    (writer_email, subject, content, type, is_resolved, created_at)
    VALUES (#{email}, #{title}, #{content}, #{inquiryType}, 0, NOW())
  </insert>

  <update id="update">
    UPDATE inquiries
    SET is_resolved = #{processed}
    WHERE inquiry_id = #{id}
  </update>

  <delete id="delete">
    DELETE FROM inquiries
    WHERE inquiry_id = #{id}
  </delete>

  <select id="findById" resultMap="InquiryResultMap">
    SELECT * FROM inquiries WHERE inquiry_id = #{id}
  </select>
</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.afivestudio.anipia.tag.infra.TagMapper">

    <resultMap id="TagResultMap" type="Tag" autoMapping="true">
        <id property="id" column="tag_id"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into tags(text)
        values (#{text})
    </insert>

    <update id="update">
        update tags
        set text = #{text}
        where tag_id = #{id}
    </update>

    <delete id="deleteById">
        delete
        from tags
        where tag_id = #{id}
    </delete>

    <select id="findById" resultMap="TagResultMap">
        select *
        from tags
        where tag_id = #{id}
    </select>

    <select id="findByText" resultMap="TagResultMap">
        select *
        from tags
        where text = #{text}
    </select>
</mapper>
